# Local dev does NOT read this file. `vercel dev` reads .vercel/.env.development.local,
# which `vercel pull` writes from the variables stored in your Vercel project.
#
# To change a value:
#   vercel env rm  GEMINI_API_KEY development
#   vercel env add GEMINI_API_KEY development
#   vercel pull
#
# This file is only a record of which variables the app expects.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Defaults to gemini-3.6-flash.
# Google retires model names over time; if the API starts returning 404,
# set this to whatever the error message recommends.
GEMINI_MODEL=gemini-3.6-flash

# Optional. Only needed if the UI is hosted somewhere other than this project.
# The deployed site calls its own /api/generate, which is same-origin and needs nothing.
# ALLOWED_ORIGINS=https://your-site.vercel.app
