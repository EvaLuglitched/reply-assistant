# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Defaults to gemini-3.6-flash (stable, wide free tier).
# Newer/faster options if your key has access: gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Optional. Comma-separated list of origins allowed to call /api/generate.
# Leave unset (or "*") while testing; lock it down before you share the link.
# ALLOWED_ORIGINS=https://your-site.vercel.app,https://aistudio.google.com
